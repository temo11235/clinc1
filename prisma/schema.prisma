generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id           String        @id @default(cuid())
  fullName     String
  phone        String        @unique
  birthDate    DateTime?
  allergies    String?
  notes        String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorName  String
  startsAt    DateTime
  durationMin Int               @default(30)
  service     String
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())

  @@index([startsAt])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}
